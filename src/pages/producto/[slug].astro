---
// Página propia de cada producto: sirve para Google y para que al compartir
// el enlace por WhatsApp/Instagram aparezca la foto, el nombre y el precio.
import Base from "../../layouts/Base.astro";
import { ICO, ART } from "../../scripts/arte.js";
import { getProductos, getTienda, getOpiniones, fotoCompartir, gs, precioMin, listas } from "../../lib/datos.js";

export async function getStaticPaths() {
  const productos = await getProductos();
  return productos.map(p => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const tienda = await getTienda();
const { tipos, ambientes } = listas(tienda, await getProductos());
const f = p.fotos[0];
// Imagen para compartir: JPG 1200×630 (más compatible con WhatsApp y Facebook que WebP).
const ogImagen = f ? await fotoCompartir(f.src) : tienda.portadaCompartir;
const ids = new Set([p.id, ...(p.incluye || []).map(i => i.slug)]);
const ops = (await getOpiniones()).filter(o => ids.has(o.producto)).slice(0, 2);
const conOpcionesDePrecio = p.opciones && p.opciones.items.some(o => o.precio);
const precio = conOpcionesDePrecio ? `desde ${gs(precioMin(p))}` : gs(p.precio);
const desc = `${p.resumen || p.descripcion || ""} ${precio}.`.trim();
const consulta = `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(p.agotado ? `¡Hola! Vi en el catálogo "${p.nombre}" que está agotado. ¿Cuándo vuelve a llegar?` : `¡Hola! Tengo una consulta sobre "${p.nombre}".`)}`;
const ld = {
  "@context": "https://schema.org", "@type": "Product", name: p.nombre, description: p.descripcion || p.resumen,
  image: f ? new URL(f.lg, Astro.site).href : undefined, category: p.categoria,
  offers: { "@type": "Offer", priceCurrency: "PYG", price: precioMin(p), availability: p.agotado ? "https://schema.org/OutOfStock" : "https://schema.org/InStock" },
};
---
<Base tienda={tienda} titulo={`${p.nombre} · ${tienda.nombre}`} descripcion={desc} imagen={ogImagen} tipos={tipos} ambientes={ambientes}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <main class="wrap">
    <nav class="crumbs" aria-label="Ruta"><a href="/">Inicio</a> / <a href="/#catalogo">{p.categoria}</a> / <span>{p.nombre}</span></nav>
    <article class="pp">
      <div>
        <div class="gal-main">
          {f
            ? <img src={f.md} srcset={`${f.sm} 400w, ${f.md} 800w, ${f.lg} 1400w`} sizes="(max-width:900px) 100vw, 640px" width={f.w} height={f.h} alt={p.nombre} />
            : <svg viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" role="img" aria-label={p.nombre}><rect width="200" height="200" fill={p.fondo || "#ece4d8"} /><Fragment set:html={ART[p.ilustracion] ? ART[p.ilustracion](p.opciones?.items?.[0]?.color || "#b85c38") : `<text x="100" y="98" text-anchor="middle" font-family="Georgia,serif" font-size="12.5" fill="#5f584f">${p.nombre.replace(/[&<>]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;"}[c]))}</text><text x="100" y="118" text-anchor="middle" font-family="system-ui,sans-serif" font-size="7" letter-spacing="1.6" fill="#776d60">FOTO PRÓXIMAMENTE</text>`} /></svg>}
        </div>
      </div>
      <div class="info">
        <span class="meta">{[...new Set([p.categoria, ...p.ambientes])].join(" · ")}</span>
        <h1 class="serif" style="font-family:var(--serif);font-weight:400;font-size:clamp(1.9rem,3.4vw,2.6rem);line-height:1.1;margin:8px 0 10px">{p.nombre}</h1>
        <div class="price">
          {p.precioAntes && !conOpcionesDePrecio ? <><b class="sale">{gs(p.precio)}</b><s>{gs(p.precioAntes)}</s></> : <b>{precio}</b>}
        </div>
        <div class={`stock${p.agotado ? " out" : ""}`}>{p.agotado ? "Agotado por ahora" : "Disponible"}</div>
        {p.opciones && <p class="opt-label" style="margin-top:12px">{p.opciones.titulo}: <b>{p.opciones.items.map(o => o.nombre).join(", ")}</b></p>}
        <div class="buy">
          {!p.agotado && <a class="btn btn-primary" href={`/#${p.id}`}><Fragment set:html={ICO.bag} />Elegir y agregar al pedido</a>}
        </div>
        {ops.length > 0 && <div class="m-ops">{ops.map(o => <figure class="op-mini"><blockquote>“{o.texto}”</blockquote><figcaption>{o.nombre}{o.barrio && `, ${o.barrio}`}</figcaption></figure>)}</div>}
        <a class={`btn ${p.agotado ? "btn-wa" : "btn-wa-ghost"}`} href={consulta} target="_blank" rel="noopener"><Fragment set:html={ICO.wa} />{p.agotado ? "Avisarme cuando llegue" : "Hacer una consulta"}</a>
        {(tienda.plazoEntrega || tienda.garantia) && (
          <ul class="m-info">
            {tienda.plazoEntrega && <li><Fragment set:html={ICO.clock} /><span>Entrega {tienda.plazoEntrega}</span></li>}
            {tienda.garantia && <li><Fragment set:html={ICO.shield} /><span>{tienda.garantia}</span></li>}
          </ul>
        )}
        {p.tipo === "combo" && (
          <div class="incluye">
            <h4>Incluye</h4>
            <ul>{p.incluye.map(i => <li><span>{i.cantidad > 1 && `${i.cantidad} × `}{i.nombre}{i.opcion && <small> ({i.opcion})</small>}</span><span>{gs(i.precio * i.cantidad)}</span></li>)}</ul>
            {p.separado > p.precio && <p class="combo-sep">Si los comprás por separado: <s>{gs(p.separado)}</s> · <b>Precio del combo: {gs(p.precio)}</b></p>}
            {p.bono && <p class="bono"><Fragment set:html={ICO.gift} /><span>{p.bono}</span></p>}
          </div>
        )}
        {p.descripcion && <p class="desc-l">{p.descripcion}</p>}
        {p.detalles.length > 0 && <dl class="specs">{p.detalles.map(d => <><dt>{d.clave}</dt><dd>{d.valor}</dd></>)}</dl>}
      </div>
    </article>
  </main>
</Base>
