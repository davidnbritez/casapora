---
import Base from "../layouts/Base.astro";
import { ICO } from "../scripts/arte.js";
import { getProductos, getTienda, getOpiniones, gs, precioMin, listas } from "../lib/datos.js";

const tienda = await getTienda();
const productos = await getProductos();
const opiniones = await getOpiniones();
const nombreDe = slug => productos.find(p => p.id === slug)?.nombre;
const { tipos, ambientes } = listas(tienda, productos);

const destacado = productos.find(p => p.id === tienda.destacado) || productos.find(p => !p.agotado);
const portada = tienda.portadaImg || destacado?.fotos?.[0];
const waHola = `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(`¡Hola ${tienda.nombre}! Quiero hacer una consulta.`)}`;
const tituloPlano = tienda.titulo.replace(/<[^>]+>/g, "");

// Datos que usa el navegador (sin campos que no hacen falta).
const { portadaImg, portadaCompartir, compromisosTodos, anunciosTodos, ...tiendaCliente } = tienda;
const datos = JSON.stringify({ tienda: tiendaCliente, productos, opiniones }).replace(/</g, "\\u003c");
---
<Base tienda={tienda} titulo={`${tienda.nombre} · ${tienda.lema}`} descripcion={tienda.bajada} imagen={tienda.portadaCompartir || portada?.lg} tipos={tipos} ambientes={ambientes} inicio>
  {portada && <link slot="head" rel="preload" as="image" href={portada.md} imagesrcset={`${portada.sm} 400w, ${portada.md} 800w, ${portada.lg} 1400w`} imagesizes="(max-width:900px) 100vw, 680px" />}

  <main>
    <div class="hero-band">
      <section class="wrap hero">
        <div>
          <p class="eyebrow">{tienda.eyebrow}</p>
          <h1 set:html={tienda.titulo} />
          <p class="lead">{tienda.bajada}</p>
          <div class="cta">
            <a href="#catalogo" class="btn btn-primary">{tienda.ctaCatalogo || "Ver el catálogo"} <Fragment set:html={ICO.arrow} /></a>
            <a class="btn btn-soft" id="heroWa" href={waHola} target="_blank" rel="noopener"><Fragment set:html={ICO.wa} />{tienda.ctaWhatsapp || "Escribinos"}</a>
          </div>
          <div class="trust">
            {tienda.compromisosTodos.map(c => <><span><Fragment set:html={ICO[c.icono] || ICO.chat} />{c.texto.split(":")[0]}</span></>)}
          </div>
        </div>
        <div class="feature">
          {portada
            ? <img src={portada.md} srcset={`${portada.sm} 400w, ${portada.md} 800w, ${portada.lg} 1400w`} sizes="(max-width:900px) 100vw, 680px" width={portada.w} height={portada.h} alt={tienda.portadaAlt || destacado?.nombre || ""} fetchpriority="high" />
            : <div style="width:100%;height:100%;background:var(--bg-3)"></div>}
          {destacado && (
            <div class="feature-card">
              <p class="eyebrow">Destacado</p>
              <h3>{destacado.nombre}</h3>
              <p>{destacado.resumen}</p>
              <div class="fc-foot">
                <button data-open={destacado.id}>Ver producto <span aria-hidden="true">→</span></button>
                <b>{(destacado.opciones && destacado.opciones.items.some(o => o.precio)) ? `desde ${gs(precioMin(destacado))}` : gs(destacado.precio)}</b>
              </div>
            </div>
          )}
        </div>
      </section>
    </div>

    {opiniones.length > 0 && (
      <section class="wrap opiniones" aria-labelledby="opTitle">
        <h2 id="opTitle" class="op-title">{tienda.opinionesTitulo || "Lo que dicen en casa"}</h2>
        <div class="op-row">
          {opiniones.slice(0, 3).map(o => (
            <figure class="op-card">
              {o.foto && <img src={o.foto.sm} width={o.foto.w} height={o.foto.h} alt="" loading="lazy" />}
              <blockquote>“{o.texto}”</blockquote>
              <figcaption><b>{o.nombre}</b>{o.barrio && `, ${o.barrio}`}{o.producto && nombreDe(o.producto) && <span>Compró: {nombreDe(o.producto)}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="wrap" aria-labelledby="catTitle">
      <div class="cat-head">
        <p class="eyebrow">{tienda.catalogoEyebrow}</p>
        <h2 id="catTitle">{tienda.catalogoTitulo}</h2>
        <p>{tienda.catalogoBajada}</p>
      </div>
      <div class="amb-row" id="ambs" role="toolbar" aria-label="Ambientes"></div>
    </section>

    <div class="toolbar" id="catalogo">
      <div class="wrap">
        <div class="tb">
          <div class="tabs" id="tabs" role="toolbar" aria-label="Tipo de producto"></div>
          <div class="search">
            <Fragment set:html={ICO.search} />
            <input id="q" type="search" placeholder="Buscar almohada, toalla, cortina…" autocomplete="off" aria-label="Buscar en el catálogo" />
            <button class="clear" id="clearQ" aria-label="Borrar búsqueda" hidden set:html={ICO.x} />
          </div>
          <label class="sort"><span class="sr">Ordenar por</span>
            <select id="sort">
              <option value="dest">Destacados</option>
              <option value="nuevo">Novedades</option>
              <option value="asc">Menor precio</option>
              <option value="desc">Mayor precio</option>
            </select>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </label>
        </div>
      </div>
    </div>

    <section class="wrap">
      <div class="results"><span id="count" aria-live="polite"></span><button id="resetFilters" hidden>Limpiar filtros</button></div>
      <div class="grid" id="grid"></div>
      <noscript>
        <ul class="grid-static">
          {productos.map(p => <li><a href={`/producto/${p.id}`}><b>{p.nombre}</b> — {gs(precioMin(p))}</a></li>)}
        </ul>
      </noscript>
    </section>
  </main>

  <Fragment slot="end">
    <button class="fab fab-cart" id="fabCart" hidden><Fragment set:html={ICO.bag} /><span class="lbl">Ver pedido</span><span class="n" id="fabN">0</span><b id="fabTotal"></b></button>

    <div class="scrim" id="scrim" aria-hidden="true">
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="mName">
        <button class="close" id="mClose" aria-label="Cerrar" set:html={ICO.x} />
        <div>
          <div class="gal-main" id="mImg"></div>
          <div class="thumbs" id="mThumbs"></div>
        </div>
        <div class="info">
          <span class="meta" id="mMeta"></span>
          <h3 id="mName"></h3>
          <div class="price" id="mPrice"></div>
          <div class="stock" id="mStock"></div>
          <div class="opt-group" id="mOpts"></div>
          <div class="buy" id="mBuy">
            <div class="stepper" aria-label="Cantidad">
              <button id="mMinus" aria-label="Menos uno" set:html={ICO.minus} />
              <output id="mQty" aria-live="polite">1</output>
              <button id="mPlus" aria-label="Más uno" set:html={ICO.plus} />
            </div>
            <button class="btn btn-primary" id="mAdd"><Fragment set:html={ICO.bag} /><span class="t">Agregar al pedido</span></button>
          </div>
          <div class="m-ops" id="mOps" hidden></div>
          <a class="btn btn-wa-ghost" id="mWa" target="_blank" rel="noopener"><Fragment set:html={ICO.wa} /><span class="t">Hacer una consulta</span></a>
          <button class="link-btn" id="mShare"><Fragment set:html={ICO.link} />Compartir producto</button>
          <ul class="m-info" id="mInfo" hidden></ul>
          <div class="incluye" id="mIncluye" hidden></div>
          <p class="desc-l" id="mDesc"></p>
          <dl class="specs" id="mSpecs"></dl>
          <div class="sug" id="mSug" hidden></div>
        </div>
      </div>
    </div>

    <div class="scrim cart-scrim" id="cartScrim" aria-hidden="true">
      <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="cTitle">
        <div class="d-head">
          <button class="back" id="cBack" hidden aria-label="Volver a tu pedido"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
          <h2 id="cTitle"><span id="cTitleTxt">Tu pedido</span><span class="sub" id="cSub"></span></h2>
          <button class="close static" id="cClose" aria-label="Cerrar pedido" set:html={ICO.x} />
        </div>
        <ol class="pasos" id="cPasos" aria-label="Pasos"><li id="cP1" aria-current="step">1. Tu pedido</li><li id="cP2">2. Tus datos</li></ol>
        <div class="d-body" id="cBody"></div>

        <form class="d-body d-form" id="cForm" hidden novalidate>
          <div class="field" data-campo="nombre">
            <label for="fNombre">Nombre y apellido</label>
            <input id="fNombre" autocomplete="name" required />
            <small class="err" hidden>Escribí tu nombre.</small>
          </div>

          {(tienda.zonas.length > 0 || tienda.retiro.activo) && (
            <fieldset class="field opciones" data-campo="entrega">
              <legend>¿Cómo lo recibís?</legend>
              {tienda.zonas.map((z, i) => (
                <label class="opcion"><input type="radio" name="entrega" value={`z${i}`} />
                  <span><b>Envío a {z.nombre}</b><small>{z.costo > 0 ? gs(z.costo) : "Costo a coordinar"}{tienda.envio.activo && !z.sinEnvioGratis && ` · gratis desde ${gs(tienda.envio.gratisDesde)}`}</small></span></label>
              ))}
              {tienda.retiro.activo && (
                <label class="opcion"><input type="radio" name="entrega" value="retiro" />
                  <span><b>{tienda.retiro.texto}</b>{tienda.retiro.detalle && <small>{tienda.retiro.detalle}</small>}</span></label>
              )}
              <small class="err" hidden>Elegí cómo lo recibís.</small>
            </fieldset>
          )}

          <div class="field" data-campo="direccion" hidden>
            <label for="fDir">Dirección</label>
            <textarea id="fDir" rows="2" autocomplete="street-address" placeholder="Calle, número, barrio y una referencia"></textarea>
            <small class="err" hidden>Escribí la dirección de entrega.</small>
          </div>

          {tienda.pagos.length > 0 && (
            <fieldset class="field opciones fila" data-campo="pago">
              <legend>¿Cómo pagás?</legend>
              {tienda.pagos.map(p => <label class="opcion chica"><input type="radio" name="pago" value={p} /><span><b>{p}</b></span></label>)}
              <small class="err" hidden>Elegí cómo pagás.</small>
            </fieldset>
          )}

          {tienda.factura.activo && (
            <div class="field-grupo">
              <label class="check"><input type="checkbox" id="fFactura" /><span>Necesito factura</span></label>
              <div class="sub-campos" id="fFacturaCampos" hidden>
                <div class="field" data-campo="ruc">
                  <label for="fRuc">RUC o cédula</label>
                  <input id="fRuc" inputmode="numeric" placeholder="Ej. 1234567-8" />
                  <small class="err" hidden>Revisá el RUC: solo números y, si tiene, el guion con el dígito final (ej. 1234567-8).</small>
                </div>
                <div class="field" data-campo="razon">
                  <label for="fRazon">Razón social</label>
                  <input id="fRazon" autocomplete="organization" />
                  <small class="err" hidden>Escribí la razón social.</small>
                </div>
              </div>
            </div>
          )}

          {tienda.regalo.activo && <label class="check"><input type="checkbox" id="cRegalo" /><span><Fragment set:html={ICO.gift} />Envolver para regalo <small>(+ {gs(tienda.regalo.precio)})</small></span></label>}

          {tienda.camposExtra.map((c, i) => (
            <div class="field" data-campo={`extra${i}`} data-extra={i}>
              <label for={`fx${i}`}>{c.etiqueta}{!c.obligatorio && <small> (opcional)</small>}</label>
              {c.opciones.length
                ? <select id={`fx${i}`}><option value="">Elegí una opción</option>{c.opciones.map(o => <option>{o}</option>)}</select>
                : <input id={`fx${i}`} />}
              {c.ayuda && <small class="ayuda">{c.ayuda}</small>}
              <small class="err" hidden>Completá este dato.</small>
            </div>
          ))}

          <div class="field">
            <label for="cNotes">Notas <small>(opcional)</small></label>
            <textarea id="cNotes" rows="2" placeholder="Horario, quién recibe, cualquier detalle"></textarea>
          </div>
          <p class="fine izq">Usamos estos datos solo para preparar y entregar tu pedido. Quedan guardados en este celular o computadora para la próxima compra.</p>
        </form>

        <div class="d-foot" id="cFoot">
          <div class="envio-bar" id="cEnvio" hidden></div>
          <dl class="resumen" id="cResumen" hidden></dl>
          <div class="total"><span>Total</span><b id="cTotal"></b></div>
          <button class="btn btn-primary" id="cNext" type="button">Continuar con mis datos <Fragment set:html={ICO.arrow} /></button>
          <div class="c-op" id="cOpinion" hidden></div>
          <a class="btn btn-wa" id="cSend" target="_blank" rel="noopener" hidden><Fragment set:html={ICO.wa} />Enviar pedido por WhatsApp</a>
          <ul class="m-info c-info" id="cInfo" hidden></ul>
          <p class="fine">Todavía no pagás nada: te confirmamos disponibilidad, envío y forma de pago por WhatsApp.</p>
        </div>
      </aside>
    </div>

    <div class="toast" id="toast" role="status"></div>

    <script is:inline id="datos" type="application/json" set:html={datos}></script>
    <script>
      import "../scripts/app.js";
    </script>
  </Fragment>
</Base>
