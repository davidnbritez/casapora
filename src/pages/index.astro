---
import Base from "../layouts/Base.astro";
import { ICO } from "../scripts/arte.js";
import { getProductos, getTienda, gs, precioMin, listas } from "../lib/datos.js";

const tienda = await getTienda();
const productos = await getProductos();
const { tipos, ambientes } = listas(tienda, productos);

const destacado = productos.find(p => p.id === tienda.destacado) || productos.find(p => !p.agotado);
const portada = tienda.portadaImg || destacado?.fotos?.[0];
const waHola = `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(`¡Hola ${tienda.nombre}! Quiero hacer una consulta.`)}`;
const tituloPlano = tienda.titulo.replace(/<[^>]+>/g, "");

// Datos que usa el navegador (sin campos que no hacen falta).
const { portadaImg, ...tiendaCliente } = tienda;
const datos = JSON.stringify({ tienda: tiendaCliente, productos }).replace(/</g, "\\u003c");
---
<Base tienda={tienda} titulo={`${tienda.nombre} · ${tienda.lema}`} descripcion={tienda.bajada} imagen={portada?.lg} tipos={tipos} ambientes={ambientes} inicio>
  {portada && <link slot="head" rel="preload" as="image" href={portada.md} imagesrcset={`${portada.sm} 400w, ${portada.md} 800w, ${portada.lg} 1400w`} imagesizes="(max-width:900px) 100vw, 680px" />}

  <main>
    <div class="hero-band">
      <section class="wrap hero">
        <div>
          <p class="eyebrow">{tienda.eyebrow}</p>
          <h1 set:html={tienda.titulo} />
          <p class="lead">{tienda.bajada}</p>
          <div class="cta">
            <a href="#catalogo" class="btn btn-primary">Explorar catálogo <Fragment set:html={ICO.arrow} /></a>
            <a class="btn btn-soft" href={waHola} target="_blank" rel="noopener"><Fragment set:html={ICO.wa} />Escribinos</a>
          </div>
          <div class="trust">
            {tienda.compromisos.map(c => <><span><Fragment set:html={ICO[c.icono] || ICO.chat} />{c.texto.split(":")[0]}</span></>)}
          </div>
        </div>
        <div class="feature">
          {portada
            ? <img src={portada.md} srcset={`${portada.sm} 400w, ${portada.md} 800w, ${portada.lg} 1400w`} sizes="(max-width:900px) 100vw, 680px" width={portada.w} height={portada.h} alt={tienda.portadaAlt || destacado?.nombre || ""} fetchpriority="high" />
            : <div style="width:100%;height:100%;background:var(--bg-3)"></div>}
          {destacado && (
            <div class="feature-card">
              <p class="eyebrow">Destacado</p>
              <h3>{destacado.nombre}</h3>
              <p>{destacado.resumen}</p>
              <div class="fc-foot">
                <button data-open={destacado.id}>Ver producto <span aria-hidden="true">→</span></button>
                <b>{(destacado.opciones && destacado.opciones.items.some(o => o.precio)) ? `desde ${gs(precioMin(destacado))}` : gs(destacado.precio)}</b>
              </div>
            </div>
          )}
        </div>
      </section>
    </div>

    <section class="wrap" aria-labelledby="catTitle">
      <div class="cat-head">
        <p class="eyebrow">{tienda.catalogoEyebrow}</p>
        <h2 id="catTitle">{tienda.catalogoTitulo}</h2>
        <p>{tienda.catalogoBajada}</p>
      </div>
      <div class="amb-row" id="ambs" role="toolbar" aria-label="Ambientes"></div>
    </section>

    <div class="toolbar" id="catalogo">
      <div class="wrap">
        <div class="tb">
          <div class="tabs" id="tabs" role="toolbar" aria-label="Tipo de producto"></div>
          <div class="search">
            <Fragment set:html={ICO.search} />
            <input id="q" type="search" placeholder="Buscar lino, canasto, taza…" autocomplete="off" aria-label="Buscar en el catálogo" />
            <button class="clear" id="clearQ" aria-label="Borrar búsqueda" hidden set:html={ICO.x} />
          </div>
          <label class="sort"><span class="sr">Ordenar por</span>
            <select id="sort">
              <option value="dest">Destacados</option>
              <option value="nuevo">Novedades</option>
              <option value="asc">Menor precio</option>
              <option value="desc">Mayor precio</option>
            </select>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </label>
        </div>
      </div>
    </div>

    <section class="wrap">
      <div class="results"><span id="count" aria-live="polite"></span><button id="resetFilters" hidden>Limpiar filtros</button></div>
      <div class="grid" id="grid"></div>
      <noscript>
        <ul class="grid-static">
          {productos.map(p => <li><a href={`/producto/${p.id}`}><b>{p.nombre}</b> — {gs(precioMin(p))}</a></li>)}
        </ul>
      </noscript>
    </section>
  </main>

  <Fragment slot="end">
    <button class="fab fab-cart" id="fabCart" hidden><Fragment set:html={ICO.bag} /><span class="lbl">Ver pedido</span><span class="n" id="fabN">0</span><b id="fabTotal"></b></button>

    <div class="scrim" id="scrim" aria-hidden="true">
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="mName">
        <button class="close" id="mClose" aria-label="Cerrar" set:html={ICO.x} />
        <div>
          <div class="gal-main" id="mImg"></div>
          <div class="thumbs" id="mThumbs"></div>
        </div>
        <div class="info">
          <span class="meta" id="mMeta"></span>
          <h3 id="mName"></h3>
          <div class="price" id="mPrice"></div>
          <div class="stock" id="mStock"></div>
          <div class="opt-group" id="mOpts"></div>
          <div class="buy" id="mBuy">
            <div class="stepper" aria-label="Cantidad">
              <button id="mMinus" aria-label="Menos uno" set:html={ICO.minus} />
              <output id="mQty" aria-live="polite">1</output>
              <button id="mPlus" aria-label="Más uno" set:html={ICO.plus} />
            </div>
            <button class="btn btn-primary" id="mAdd"><Fragment set:html={ICO.bag} /><span class="t">Agregar al pedido</span></button>
          </div>
          <a class="btn btn-wa-ghost" id="mWa" target="_blank" rel="noopener"><Fragment set:html={ICO.wa} /><span class="t">Hacer una consulta</span></a>
          <button class="link-btn" id="mShare"><Fragment set:html={ICO.link} />Compartir producto</button>
          <p class="desc-l" id="mDesc"></p>
          <dl class="specs" id="mSpecs"></dl>
        </div>
      </div>
    </div>

    <div class="scrim cart-scrim" id="cartScrim" aria-hidden="true">
      <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="cTitle">
        <div class="d-head">
          <h2 id="cTitle">Tu pedido<span class="sub" id="cSub"></span></h2>
          <button class="close static" id="cClose" aria-label="Cerrar pedido" set:html={ICO.x} />
        </div>
        <div class="d-body" id="cBody"></div>
        <div class="d-fields" id="cFields">
          <label class="field"><span>Tu nombre <small>(opcional)</small></span><input id="cName" autocomplete="name" /></label>
          <label class="field"><span>Notas <small>(dirección, horario o si retirás)</small></span><textarea id="cNotes" rows="2"></textarea></label>
        </div>
        <div class="d-foot" id="cFoot">
          <div class="total"><span>Total</span><b id="cTotal"></b></div>
          <a class="btn btn-wa" id="cSend" target="_blank" rel="noopener"><Fragment set:html={ICO.wa} />Enviar pedido por WhatsApp</a>
          <p class="fine">Todavía no pagás nada: te confirmamos disponibilidad, envío y forma de pago por WhatsApp.</p>
        </div>
      </aside>
    </div>

    <div class="toast" id="toast" role="status"></div>

    <script is:inline id="datos" type="application/json" set:html={datos}></script>
    <script>
      import "../scripts/app.js";
    </script>
  </Fragment>
</Base>
