---
import "../styles/global.css";
import { ICO } from "../scripts/arte.js";

const { tienda, titulo, descripcion, imagen, tipos = [], ambientes = [], inicio = false } = Astro.props;
const waHola = `https://wa.me/${tienda.whatsapp}?text=${encodeURIComponent(`¡Hola ${tienda.nombre}! Quiero hacer una consulta.`)}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImg = imagen ? new URL(imagen, Astro.site).href : null;
const anio = new Date().getFullYear();
const raiz = inicio ? "" : "/";
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#faf8f5" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_PY" />
  <meta property="og:site_name" content={tienda.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonical} />
  {ogImg && <meta property="og:image" content={ogImg} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>
<body>
  <a class="skip" href={`${raiz}#catalogo`}>Saltar al catálogo</a>

  <div class="announce">{tienda.anuncios.map(a => <span>{a}</span>)}</div>

  <header class="top">
    <div class="wrap bar">
      <a href="/" class="brand" id="brand"><span class="name">{tienda.nombre}</span><span class="tag">{tienda.lema}</span></a>
      <nav class="main" aria-label="Categorías">
        {tipos.slice(0, 5).map(t => inicio ? <button data-goto-tipo={t}>{t}</button> : <a href="/#catalogo">{t}</a>)}
      </nav>
      <div class="bar-actions">
        <a class="icon-btn" href={waHola} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp" set:html={ICO.wa} />
        {inicio
          ? <button class="cart-btn" id="cartBtn" aria-label="Ver tu pedido"><Fragment set:html={ICO.bag} /><span class="lbl">Mi pedido</span><span class="cart-count" id="cartCount" hidden>0</span></button>
          : <a class="cart-btn" href="/#pedido"><Fragment set:html={ICO.bag} /><span class="lbl">Mi pedido</span></a>}
      </div>
    </div>
  </header>

  <slot />

  <section class="band" aria-label="Nuestro compromiso">
    <div class="wrap">
      {tienda.compromisos.map(c => {
        const [t, ...r] = c.texto.split(":");
        return <div><Fragment set:html={ICO[c.icono] || ICO.chat} /><div><b>{t}</b>{r.length > 0 && <p>{r.join(":").trim()}</p>}</div></div>;
      })}
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="f-grid">
        <div class="f-brand"><div class="name">{tienda.nombre}</div><p>{tienda.sobre}</p></div>
        <div><h4>Colección</h4><ul>{tipos.map(t => <li>{inicio ? <button data-goto-tipo={t}>{t}</button> : <a href="/#catalogo">{t}</a>}</li>)}</ul></div>
        <div><h4>Ambientes</h4><ul>{ambientes.map(a => <li>{inicio ? <button data-goto-amb={a}>{a}</button> : <a href="/#catalogo">{a}</a>}</li>)}</ul></div>
        <div><h4>Nuestro compromiso</h4><ul class="f-promise">{tienda.compromisos.map(c => <li><Fragment set:html={ICO[c.icono] || ICO.chat} /><span>{c.texto}</span></li>)}</ul></div>
      </div>
      <div class="f-bottom"><span>© {anio} {tienda.nombre}. {tienda.pie}</span><a href={waHola} target="_blank" rel="noopener">WhatsApp +{tienda.whatsapp}</a></div>
    </div>
  </footer>

  <a class="fab" id="fab" href={waHola} target="_blank" rel="noopener" aria-label="Consultar por WhatsApp"><Fragment set:html={ICO.wa} /><span>Consultar</span></a>
  <slot name="end" />
</body>
</html>
